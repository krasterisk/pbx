{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.proto", "watchAssets": true },
      { "include": "skills/**/*.md", "watchAssets": false }
    ],
    "watchAssets": false
  }
}
