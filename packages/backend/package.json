{
  "name": "@krasterisk/backend",
  "version": "4.4.4",
  "description": "Krasterisk v4 Backend",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.build.json --pretty false",
    "build:analytics": "nest build --config nest-cli.analytics.json",
    "build:robot": "nest build --config nest-cli.robot.json",
    "build:community": "nest build --config nest-cli.community.json",
    "test:analytics:composition": "npm run build:analytics && node ../../harness/database/check-analytics-build.cjs",
    "test:robot:composition": "npm run build:robot && node ../../harness/database/check-analytics-build.cjs robot",
    "test:community:composition": "npm run build:community && node ../../harness/database/check-analytics-build.cjs community",
    "test:analytics:source-boundary": "node ../../harness/database/check-analytics-source-boundary.cjs",
    "test:robot:source-boundary": "node ../../harness/database/check-analytics-source-boundary.cjs robot",
    "test:community:source-boundary": "node ../../harness/database/check-analytics-source-boundary.cjs community",
    "start:analytics": "node dist-analytics/analytics.main.js",
    "start:robot": "node dist-robot/robot.main.js",
    "start:community": "node dist-community/community.main.js",
    "start:ai-api": "node dist/ai-api.main.js",
    "start:ai-worker": "node dist/ai-worker.main.js",
    "start:media-worker": "node dist/media-worker.main.js",
    "provision:analytics": "node dist-analytics/standalone-provision.main.js",
    "provision:robot": "node dist-robot/standalone-provision.main.js",
    "postbuild": "node database/copy-build-assets.cjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "prestart:dev": "node database/copy-build-assets.cjs",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "eval:speech-analytics": "ts-node -r tsconfig-paths/register src/modules/speech-analytics/eval/run-golden.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cc": "jest --testPathPattern=\"modules/callcenter\" --no-coverage",
    "test:cc:watch": "jest --testPathPattern=\"modules/callcenter\" --watch --no-coverage",
    "test:ai": "jest --testPathPattern=\"modules/(ai-agents|ai-platform|ai-chat|mcp)\" --no-coverage",
    "test:ai:watch": "jest --testPathPattern=\"modules/(ai-agents|ai-platform|ai-chat|mcp)\" --watch --no-coverage",
    "test:pbx-agent-eval": "jest --testPathPattern=\"pbx-agent-eval\" --no-coverage",
    "db:migrate": "node database/run-migrations.cjs",
    "db:migrate:list": "node database/run-migrations.cjs --list",
    "db:migrate:status": "node database/run-migrations.cjs --status",
    "db:migrate:rollback": "node database/run-migrations.cjs --rollback",
    "db:setup:directories": "ts-node -r tsconfig-paths/register src/modules/directories/setup-directories-schema.ts",
    "db:report:legacy-confbridge": "ts-node -r tsconfig-paths/register src/modules/conferences/report-legacy-confbridge-steps.ts",
    "db:setup:conferences": "ts-node -r tsconfig-paths/register src/modules/conferences/setup-conferences-schema.ts",
    "db:setup:autodial": "ts-node -r tsconfig-paths/register src/modules/autodial/setup-autodial-schema.ts",
    "db:setup:agent-threads": "ts-node -r tsconfig-paths/register src/modules/ai-chat/migrate-agent-threads.ts",
    "db:setup:agent-brief": "ts-node -r tsconfig-paths/register src/modules/ai-chat/migrate-agent-brief.ts",
    "db:setup:agent-workflows": "ts-node -r tsconfig-paths/register src/modules/ai-chat/migrate-agent-workflows.ts",
    "db:setup:agent-timeline": "ts-node -r tsconfig-paths/register src/modules/ai-chat/migrate-agent-timeline.ts",
    "db:seed:ci": "node database/seed-ci.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@huggingface/transformers": "^4.1.0",
    "@krasterisk/shared": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/platform-socket.io": "^11.0.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.10",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "ari-client": "^2.2.0",
    "asterisk-manager": "^0.2.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.1",
    "bullmq": "^5.76.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.3",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mysql2": "^3.12.0",
    "natural": "^8.1.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.5",
    "onnxruntime-node": "^1.24.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.6",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^3.4.0",
    "ws": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@types/ari-client": "^2.2.13",
    "@types/asterisk-manager": "^0.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 2
  }
}
