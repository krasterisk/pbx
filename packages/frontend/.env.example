# Frontend env — copy to .env.local / flavor files (NAV-11 / D-34)
# Capacitor 8 requires Node.js 22+.

# --- API / WSS flavors (build-time) ---
# Prefer absolute HTTPS URLs for native Android/iOS builds.
# Dev (Vite proxy): leave as /api or omit.
VITE_API_URL=/api

# Optional WebSocket / socket.io base (empty = same-origin relative in web).
# VITE_WSS_URL=wss://staging.example.com/socket.io

# Flavor hints (document only — select via .env.dev / .env.staging / .env.prod):
#   dev:     VITE_API_URL=/api
#   staging: VITE_API_URL=https://staging.example.com/api
#            VITE_WSS_URL=wss://staging.example.com/socket.io
#   prod:    VITE_API_URL=https://api.example.com/api
#            VITE_WSS_URL=wss://api.example.com/socket.io
#
# Runtime override (debug/on-prem only): Capacitor Preferences keys
#   apiUrlOverride / wssUrlOverride — see shared/lib/capacitor/envUrls.ts
# Do not expose override UI in production without ADMIN (T-08-17).
