FROM node:22-bookworm AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/backend/package.json packages/backend/package.json
COPY packages/frontend/package.json packages/frontend/package.json
COPY harness/package.json harness/package.json
# shared "prepare" runs tsc. Sources are copied after install.
RUN npm pkg delete scripts.prepare -w @krasterisk/shared && npm ci --ignore-scripts
COPY packages/shared packages/shared
COPY packages/backend packages/backend
COPY tsconfig.base.json tsconfig.base.json
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build -w @krasterisk/shared && npm run build -w @krasterisk/backend

FROM node:22-bookworm-slim
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src /src
ENV NODE_ENV=production
ENV NODE_PATH=/src/node_modules
WORKDIR /src/packages/backend
EXPOSE 5010
CMD ["node", "dist/main.js"]
