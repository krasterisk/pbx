{
  "name": "krasterisk-v4",
  "version": "4.5.7",
  "description": "IP PBX Krasterisk — Modern Web Interface",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend",
    "harness"
  ],
  "scripts": {
    "dev:backend": "npm run build -w @krasterisk/shared && npm run start:dev -w @krasterisk/backend",
    "dev:frontend": "npm run dev -w @krasterisk/frontend",
    "build": "npm run build -w @krasterisk/shared && npm run build -w @krasterisk/backend && npm run build -w @krasterisk/frontend",
    "lint": "npm run lint -w @krasterisk/backend && npm run lint -w @krasterisk/frontend",
    "test": "npm run test -w @krasterisk/backend && npm run test -w @krasterisk/frontend",
    "test:backend": "npm run test -w @krasterisk/backend",
    "test:frontend": "npm run test -w @krasterisk/frontend",
    "test:cc": "npm run test:cc -w @krasterisk/backend && npm run test:cc -w @krasterisk/frontend",
    "test:ai": "npm run test:ai -w @krasterisk/backend && npm run test:ai -w @krasterisk/frontend",
    "test:cov": "npm run test:cov -w @krasterisk/backend && npm run test:cov -w @krasterisk/frontend",
    "test:watch": "npm run test:watch -w @krasterisk/frontend",
    "harness": "npm run test -w @krasterisk/harness",
    "harness:api": "npm run test:api -w @krasterisk/harness --",
    "harness:ui": "npm run test:ui -w @krasterisk/harness",
    "harness:asterisk": "npm run test:asterisk -w @krasterisk/harness",
    "harness:ai-chat": "npm run test:ai-chat -w @krasterisk/harness",
    "harness:ai-chat:live": "npm run test:ai-chat:live -w @krasterisk/harness",
    "db:migrate": "npm run db:migrate -w @krasterisk/backend",
    "db:migrate:list": "npm run db:migrate:list -w @krasterisk/backend",
    "db:migrate:status": "npm run db:migrate:status -w @krasterisk/backend",
    "test:db:unit": "node --test packages/backend/database/test/*.test.cjs",
    "test:db:schema": "node --test harness/database/schema-inventory.test.cjs",
    "test:db:contracts": "node harness/database/run-contracts.cjs",
    "test:db:i1": "node --test harness/database/clean-install.test.cjs",
    "test:db:i1:install": "node harness/database/run-i1-install.cjs",
    "test:db:i2": "node --test harness/database/backup-restore.test.cjs",
    "test:db:i2:restore": "node harness/database/run-i2-restore.cjs",
    "test:db:i3": "node --test harness/database/upgrade.test.cjs",
    "test:db:i3:upgrade": "node harness/database/run-i3-upgrade.cjs",
    "test:db:i4": "node --test harness/database/odbc-installer.test.cjs",
    "test:db:i4:odbc": "node harness/database/run-i4-odbc.cjs",
    "test:db:10a": "node --test harness/database/run-10a-docs.test.cjs",
    "test:db:10a:smoke": "node harness/database/run-10a-smoke.cjs",
    "test:db:10r": "node --test harness/database/run-10r-docs.test.cjs",
    "test:db:10r:smoke": "node harness/database/run-10r-smoke.cjs",
    "test:db:11l": "node --test harness/database/run-11l-docs.test.cjs",
    "test:db:11l:load": "node harness/database/run-11l-load.cjs",
    "test:db:11f": "node --test harness/database/run-11f-docs.test.cjs",
    "test:db:11f:fault": "node harness/database/run-11f-fault.cjs",
    "test:db:11o": "node --test harness/database/run-11o-docs.test.cjs",
    "test:db:11o:ops": "node harness/database/run-11o-ops.cjs",
    "test:db:11a": "node --test harness/database/run-11a-docs.test.cjs",
    "test:db:11a:uat": "node harness/database/run-11a-uat.cjs",
    "test:db:11r": "node --test harness/database/run-11r-docs.test.cjs",
    "test:db:11r:uat": "node harness/database/run-11r-uat.cjs",
    "test:db:11m": "node --test harness/database/run-11m-docs.test.cjs",
    "test:db:11m:matrix": "node harness/database/run-11m-matrix.cjs",
    "test:db:pending-gates": "node --test harness/database/run-pending-gates.test.cjs",
    "test:db:runtime": "node harness/database/run-runtime-golden.cjs",
    "db:migrate:rollback": "npm run db:migrate:rollback -w @krasterisk/backend --"
  },
  "author": "Krasterisk LTD",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
