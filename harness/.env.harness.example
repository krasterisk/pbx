# Harness environment template (D-08). Copy to .env.harness (gitignored) for local runs.
# Never commit real secrets — use CI secrets / local overrides only.

# --- Core URLs (direct backend port — not Vite proxy, RESEARCH Pitfall 5) ---
HARNESS_API_URL=http://localhost:5010
PLAYWRIGHT_BASE_URL=http://localhost:3010

# --- Auth (D-13) ---
PW_USER=admin
PW_PASS=admin

# --- Readiness ---
# RUN_MIGRATE=1          # run npm run db:migrate before health poll
# SKIP_READINESS=1       # skip waitForAppReady in runner (unit-only tests)
# WAIT_FOR_FRONTEND=1    # poll PLAYWRIGHT_BASE_URL during readiness

# --- MySQL (GHA e2e.yml compatible defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=krasterisk
DB_NAME=krasterisk

# USE_TESTCONTAINERS=1   # start ephemeral MySQL via Testcontainers (requires Docker)
# USE_TESTCONTAINERS=0   # use DB_* above (CI services / docker-compose)

# --- Backend secrets (placeholders — set real values locally / in CI) ---
JWT_SECRET=change-me-local-dev
CC_AI_KEY_SECRET=change-me-local-dev

# --- Asterisk lab (plan 07, D-05–D-08) ---
HAS_ASTERISK=0
# Set HAS_ASTERISK=1 and configure AMI/ARI when a lab is available.
# AMI_HOST=127.0.0.1
# AMI_PORT=5038
# AMI_LOGIN=krasterisk
# AMI_SECRET=change-me
# ARI_PROTOCOL=http
# ARI_HOST=127.0.0.1
# ARI_PORT=8088
# ARI_USER=krasterisk
# ARI_PASSWORD=change-me
# HARNESS_PROFILE=asterisk
# HARNESS_ORIGINATE_EXTEN=100
# HARNESS_ORIGINATE_CONTEXT=from-internal
# HARNESS_AGENT_INTERFACE=100
# HARNESS_ORIGINATE_MODE=ami
# HARNESS_CLICK_TO_CALL_TARGET=100
