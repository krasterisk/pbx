{
  "name": "@krasterisk/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Black-box harness layer for Krasterisk v4",
  "scripts": {
    "test": "vitest run scenarios/api scenarios/realtime && playwright test",
    "test:api": "tsx runner/index.ts --kind api",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testcontainers/mysql": "^10.28.0",
    "@types/node": "^22.13.4",
    "eventsource": "^2.0.2",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "pino": "^9.14.0"
  }
}
